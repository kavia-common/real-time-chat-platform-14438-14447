# Example environment variables for chat_backend
# Copy this file to .env and set the appropriate values.

# MongoDB connection
MONGODB_URI=mongodb+srv://<user>:<pass>@<host>/<db>?retryWrites=true&w=majority
MONGODB_DB=chat_app

# JWT configuration
JWT_SECRET_KEY=replace_with_strong_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
